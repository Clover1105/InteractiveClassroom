# 向量化相关配置
# 通用 -- 向量模型路径
VECTORIZE_MODEL_PATH=

# 问答 -- 向量数据库路径、向量数据集名称、原始数据路径
QA_CHROMADB_PATH=
QA_VECTOR_DATASET_NAME=teach_qa
RAW_DATA_PATH=

# 课件 -- 向量数据库路径、向量数据集名称
CW_CHROMADB_PATH=
CW_VECTOR_DATASET_NAME=courseware

# 记忆 -- 向量数据库路径、向量数据集名称
MEMORY_CHROMADB_PATH=
MEMORY_VECTOR_DATASET_NAME=memory

# 数据库相关配置
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=interactiveclassroom
MYSQL_CHARSET=utf8mb4

# 邮件相关配置
SENDER_EMAIL_PASSWORD=
SENDER_EMAIL=
EMAIL_TO=
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465

# redis 相关配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# neo4j 相关配置
NEO4J_HOST=neo4j://127.0.0.1:7687
NEO4J_ACCOUNT=neo4j
NEO4J_PASSWORD=
NEO4J_NAME=courseware

# 在线大模型的配置
MODEL_ONLINE_NAME=
OPENAI_API_BASE=

# 本地大模型的配置
MODEL_LOCAL_NAME=
LOCAL_URL=http://localhost:11434/v1

# Postgres 内存地址
POSTGRESQL_URL=

# 窗口记忆消息配置（生产环境至少 40 次）
WINDOW_MEMORY_ROUND=4
# 窗口记忆过期时间（秒），生产环境一天（86400）
WINDOW_MEMORY_EXPIRE_TIME=300

# JWT 相关配置
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
